# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or mongodb://localhost:27017/financeflow)
MONGODB_URI=mongodb://localhost:27017/financeflow

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
